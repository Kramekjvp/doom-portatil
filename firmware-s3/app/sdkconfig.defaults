# Mantido igual ao examples/doom_standalone/sdkconfig.defaults.
# Tick de 1 ms: o laco de 16 ms e o I_Sleep(1) do Doom ficam precisos.
CONFIG_FREERTOS_HZ=1000
# N16R8: 16 MB de flash, 8 MB de PSRAM octal.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# malloc() grande (zona do Doom, 6 MB) vai para a PSRAM; pequenos ficam na RAM interna
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Doom e pesado em CPU: -O2 em vez de -Og
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Cache de dados maior ajuda muito quando a zona do Doom esta na PSRAM.
# (nomes conferidos no menuconfig: Component config > ESP System Settings / Hardware Settings)
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
